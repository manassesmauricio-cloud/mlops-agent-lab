# ═══════════════════════════════════════════════════════
#  Variables de Entorno — MLOps Agent Lab
#  Copiar a .env y completar con tus valores
# ═══════════════════════════════════════════════════════

# ── Proveedor LLM ────────────────────────────────────────────────────────────
# Elige el proveedor que quieras usar. Solo necesitas la API key del elegido.
#
#   anthropic  → default, usa Claude
#   openai     → usa GPT-4o u otro modelo de OpenAI
#   google     → usa Gemini
#   groq       → usa Llama 3.3 (muy rápido, capa gratuita generosa)
#   mistral    → usa Mistral Large
#
LLM_PROVIDER=anthropic

# Modelo a usar. Si lo dejas vacío, se usa el default del proveedor.
# LLM_MODEL=claude-sonnet-4-6   # anthropic
# LLM_MODEL=gpt-4o              # openai
# LLM_MODEL=gemini-2.0-flash    # google
# LLM_MODEL=llama-3.3-70b-versatile  # groq
# LLM_MODEL=mistral-large-latest     # mistral

# ── API Keys (solo la del proveedor elegido) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...

# ── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USER=admin
AIRFLOW_PASS=admin

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Rutas (opcionales — el agente usa valores por defecto si no se definen) ──
# MONITORING_FILE=/ruta/a/monitoring/latest_metrics.json
# POLICIES_FILE=/ruta/a/policies/policies.yaml
# LOG_FILE=/ruta/a/logs/agent_log.csv
